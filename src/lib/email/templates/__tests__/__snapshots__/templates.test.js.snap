          <td style="padding:0 0 12px 0;" align="center">
            <a href="https://scholarmarket.test" style="text-decoration:none;color:#111827;">
              <span style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-weight:700;font-size:18px;">ScholarMarket</span>
            </a>
          </td>
        </tr>
        <tr>
          <td class="card" style="background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,0.06);">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
              
              <tr>
                <td style="padding:24px 24px 8px 24px;">
                  
    <h1 style="margin:0 0 8px 0;font-size:22px;line-height:1.3;color:#111827;">Your catalog needs attention</h1>
    <p class="muted" style="margin:0 0 16px 0;font-size:14px;line-height:1.6;color:#6b7280;">
      Hi Ada, your ScholarMarket profile has been inactive for <strong>200 days</strong>.
    </p>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 16px 0;">
      <tr>
        <td style="background:#f0f4ff;border:1px solid #e0e7ff;border-radius:8px;padding:12px 16px;">
          <p style="margin:0 0 4px 0;font-size:12px;text-transform:uppercase;color:#6b7280;">Catalog items</p>
          <p style="margin:0;font-size:20px;font-weight:700;color:#111827;">5</p>
        </td>
        <td style="width:8px;"></td>
       <td style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:12px 16px;">
         <p style="margin:0 0 4px 0;font-size:12px;text-transform:uppercase;color:#6b7280;">Low-relevance flagged</p>
         <p style="margin:0;font-size:20px;font-weight:700;color:#dc2626;">2</p>
       </td>
      </tr>
    </table>
    <p style="margin:0 0 8px 0;font-size:14px;line-height:1.6;color:#111827;">2 of your 5 catalog item(s) have been marked as low-relevance and may not appear in marketplace search results.</p>
    <p style="margin:0 0 8px 0;font-size:14px;line-height:1.6;color:#111827;">To keep your catalog visible:</p>
    <ol style="margin:0 0 16px 0;padding-left:20px;font-size:14px;line-height:1.8;color:#374151;">
      <li>Log in and review your published materials</li>
      <li>Update descriptions, pricing, or thumbnails</li>
      <li>Publish new content to signal active stewardship</li>
    </ol>
    <p style="margin:20px 0;">
      <a href="https://scholarmarket.test/dashboard" style="display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;padding:12px 16px;border-radius:8px;font-weight:600;font-size:14px;">Go to your dashboard</a>
    </p>
    <p class="muted" style="margin:0;font-size:13px;line-height:1.6;color:#6b7280;">
      If you no longer plan to maintain your catalog, consider unpublishing your materials to keep the marketplace high-quality.
    </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td align="center" style="padding:16px 8px 0 8px;">
            <p class="muted" style="margin:0 0 8px 0;font-size:12px;color:#6b7280;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">You&#39;re receiving this because you have a creator profile on ScholarMarket.</p>
            <p class="muted" style="margin:0 0 8px 0;font-size:12px;color:#6b7280;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
          <a href="https://scholarmarket.test/api/email/unsubscribe?token=eyJlbWFpbCI6ImNyZWF0b3JAZXhhbXBsZS5jb20iLCJjYXRlZ29yeSI6InJlbWluZGVycyJ9.t6zERJldw6uhz6ouZxYq16bHf2SU0w0iDHZQ9p3RkHo" style="color:#6b7280;text-decoration:underline;">Unsubscribe</a>
        </p>
            <p class="muted" style="margin:0 0 24px 0;font-size:12px;color:#6b7280;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
              &copy; 2026 ScholarMarket
            </p>
          </td>
        </tr>
      </table>
    </td></tr>
  </table>
</body>
</html>"
`;

exports[`email templates > renders the inactivity reminder with a working unsubscribe link 2`] = `
"Hi Ada,

Your ScholarMarket profile has been inactive for 200 days.

2 of your 5 catalog item(s) have been marked as low-relevance and may not appear in marketplace search results.

To keep your catalog visible:
  1. Log in and review your published materials.
  2. Update descriptions, pricing, or thumbnails.
  3. Publish new content to signal active stewardship.

Dashboard: https://scholarmarket.test/dashboard
Profile: https://scholarmarket.test/profile

If you no longer plan to maintain your catalog, consider unpublishing your materials to keep the marketplace high-quality.


— ScholarMarket Team

Unsubscribe: https://scholarmarket.test/api/email/unsubscribe?token=eyJlbWFpbCI6ImNyZWF0b3JAZXhhbXBsZS5jb20iLCJjYXRlZ29yeSI6InJlbWluZGVycyJ9.t6zERJldw6uhz6ouZxYq16bHf2SU0w0iDHZQ9p3RkHo
© 2026 ScholarMarket"
`;

